  "ui": {
    "description": "ui",
    "type": "object",
    "items": {
      "render_cache_ttl_seconds": {
        "type": "int",
        "default": 86400,
        "description": "渲染临时文件保留秒数"
      },
      "pool_image_cache_ttl_seconds": {
        "type": "int",
        "default": 604800,
        "description": "卡池公告图缓存秒数"
      },
      "max_pool_image_bytes": {
        "type": "int",
        "default": 8388608,
        "description": "卡池公告图单张最大字节数"
      },
      "short_reply_max_lines": {
        "type": "int",
        "default": 10,
        "description": "短回复直接发文字的最大行数"
      },
      "short_reply_max_chars": {
        "type": "int",
        "default": 700,
        "description": "短回复直接发文字的最大字符数"
      }
