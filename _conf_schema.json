{
  "plugin": {
    "description": "插件基础设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "保留的配置占位开关（由插件管理控制启停）",
        "type": "bool",
        "default": true,
        "invisible": true
      },
      "config_version": {
        "description": "配置版本标记",
        "type": "string",
        "default": "1.2.0",
        "invisible": true
      }
    }
  },
  "assets": {
    "description": "本地素材路径",
    "type": "object",
    "items": {
      "cards_dir": {
        "description": "卡面 PNG 目录",
        "hint": "默认读取插件 assets/card_data；可填写绝对路径指向外部素材。",
        "type": "string",
        "default": "assets/card_data"
      },
      "card_info_json": {
        "description": "卡牌信息 JSON 路径",
        "hint": "默认读取插件 assets/card_data/card_info_merged.json。",
        "type": "string",
        "default": "assets/card_data/card_info_merged.json"
      }
    }
  },
  "pool": {
    "description": "模拟器概率权重与卡池轮替",
    "type": "object",
    "items": {
      "weight_n": {
        "description": "N 权重（正式普通池不使用）",
        "type": "int",
        "default": 0
      },
      "weight_r": {
        "description": "R 权重（参照 Artemis 普通池）",
        "type": "int",
        "default": 77
      },
      "weight_sr": {
        "description": "SR 权重（参照 Artemis 普通池）",
        "type": "int",
        "default": 20
      },
      "weight_sr_plus": {
        "description": "SR+ 权重（正式普通池不使用）",
        "type": "int",
        "default": 0
      },
      "weight_ssr": {
        "description": "SSR 权重",
        "type": "int",
        "default": 3
      },
      "schedule_json": {
        "description": "官方卡池排表 JSON",
        "hint": "默认读取插件 assets/card_data/gacha_pools.json。",
        "type": "string",
        "default": "assets/card_data/gacha_pools.json"
      },
      "rotation_mode": {
        "description": "卡池选择模式",
        "hint": "official=按官方日期选池；cycle=按间隔循环历史官方池。",
        "type": "string",
        "default": "cycle"
      },
      "rotation_interval_days": {
        "description": "cycle 模式下每个池的持续天数",
        "type": "int",
        "slider": {"min": 1, "max": 30, "step": 1},
        "default": 15
      },
      "pickup_multiplier": {
        "description": "UP 卡相对普通卡的权重倍率",
        "type": "int",
        "slider": {"min": 1, "max": 50, "step": 1},
        "default": 10
      },
      "strict_pool_cards": {
        "description": "按池子候选列表抽取",
        "hint": "常驻池使用 regular_pool，活动池使用排表 cards。",
        "type": "bool",
        "default": true
      }
    }
  },
  "economy": {
    "description": "点数、签到与消耗配置",
    "type": "object",
    "items": {
      "cost_1": {
        "description": "1 连消耗点数",
        "type": "int",
        "default": 50
      },
      "cost_5": {
        "description": "5 连消耗点数",
        "type": "int",
        "default": 250
      },
      "cost_11": {
        "description": "11 连消耗点数",
        "type": "int",
        "default": 500
      },
      "min_reward": {
        "description": "每日签到最低点数",
        "type": "int",
        "default": 100
      },
      "max_reward": {
        "description": "每日签到最高点数",
        "type": "int",
        "default": 250
      },
      "tz_offset_hours": {
        "description": "保留字段，日期与任务重置固定使用国际时间 UTC",
        "type": "int",
        "slider": {"min": -12, "max": 14, "step": 1},
        "default": 0
      },
      "streak_daily_step": {
        "description": "连续签到每天递增额外点数",
        "type": "int",
        "default": 10
      },
      "streak_daily_max": {
        "description": "连续签到每日额外点数上限",
        "type": "int",
        "default": 100
      },
      "streak_weekly_reward": {
        "description": "每连续签到 7 天额外奖励点数",
        "type": "int",
        "default": 500
      },
      "streak_cycle_days": {
        "description": "每连续签到多少天发放卡池周期奖励",
        "type": "int",
        "default": 15
      },
      "streak_cycle_reward": {
        "description": "卡池周期奖励点数",
        "type": "int",
        "default": 1000
      },
      "non_gacha_checkin_probability": {
        "description": "每日签到随机获得非抽卡卡的概率（0～1）",
        "type": "float",
        "slider": {"min": 0, "max": 1, "step": 0.01},
        "default": 0.05
      },
      "savings_threshold_1": {
        "description": "囤点奖励第 1 档门槛",
        "type": "int",
        "default": 1000
      },
      "savings_bonus_1": {
        "description": "囤点奖励第 1 档点数",
        "type": "int",
        "default": 100
      },
      "savings_threshold_2": {
        "description": "囤点奖励第 2 档门槛",
        "type": "int",
        "default": 3000
      },
      "savings_bonus_2": {
        "description": "囤点奖励第 2 档点数",
        "type": "int",
        "default": 500
      },
      "savings_threshold_3": {
        "description": "囤点奖励第 3 档门槛",
        "type": "int",
        "default": 10000
      },
      "savings_bonus_3": {
        "description": "囤点奖励第 3 档点数",
        "type": "int",
        "default": 2000
      },
      "savings_bonus_reset_days": {
        "description": "囤点档位奖励重置周期（天）",
        "type": "int",
        "slider": {"min": 1, "max": 365, "step": 1},
        "default": 60
      }
    }
  },
  "monthly_card": {
    "description": "月卡配置",
    "type": "object",
    "items": {
      "price": {
        "description": "购买月卡消耗点数",
        "type": "int",
        "default": 1500
      },
      "duration_days": {
        "description": "月卡有效天数",
        "type": "int",
        "default": 30
      },
      "daily_bonus": {
        "description": "月卡有效期每日签到额外点数",
        "type": "int",
        "default": 100
      },
      "renew_max_remaining_days": {
        "description": "剩余不超过多少天才能续费",
        "type": "int",
        "default": 3
      },
      "half_price_5_pull_count": {
        "description": "购买后赠送的半价五连次数",
        "type": "int",
        "default": 2
      }
    }
  },
  "admin": {
    "description": "管理员配置",
    "type": "object",
    "items": {
      "admin_ids": {
        "description": "允许发放点数的管理员 ID 列表（QQ官方 openid 或已绑定数字QQ）",
        "type": "list",
        "default": []
      },
      "allow_local_operator": {
        "description": "是否允许本地操作用户视为管理员",
        "hint": "默认关闭；开启后本地操作用户也可使用 /奖励。",
        "type": "bool",
        "default": false
      }
    }
  },
  "task": {
    "description": "随机任务",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否启用随机任务",
        "type": "bool",
        "default": true
      },
      "normal_count": {
        "description": "每日普通任务次数",
        "type": "int",
        "slider": {"min": 1, "max": 20, "step": 1},
        "default": 5
      },
      "challenge_count": {
        "description": "每日挑战任务次数",
        "type": "int",
        "slider": {"min": 1, "max": 20, "step": 1},
        "default": 3
      },
      "challenge_min_level": {
        "description": "挑战最低等级，默认 10 级或以上",
        "type": "float",
        "slider": {"min": 1, "max": 15, "step": 0.5},
        "default": 10.0
      },
      "ultimate_min_level": {
        "description": "终极最低定数",
        "type": "float",
        "slider": {"min": 1, "max": 15.5, "step": 0.1},
        "default": 14.7
      },
      "normal_reward": {
        "description": "普通任务奖励",
        "type": "int",
        "default": 20
      },
      "challenge_reward_s": {
        "description": "挑战 S 奖励",
        "type": "int",
        "default": 30
      },
      "challenge_reward_ss": {
        "description": "挑战 SS 奖励",
        "type": "int",
        "default": 40
      },
      "challenge_reward_sss": {
        "description": "挑战 SSS/SSS+ 奖励",
        "type": "int",
        "default": 50
      },
      "ultimate_reward": {
        "description": "终极任务奖励",
        "type": "int",
        "default": 30000
      },
      "exclude_special": {
        "description": "排除 LUNATIC / 宴会场 / WORLD'S END 等特殊谱面",
        "type": "bool",
        "default": true
      },
      "require_photo": {
        "description": "提交任务时是否要求图片",
        "type": "bool",
        "default": true
      },
      "auto_reset": {
        "description": "每日 00:00 自动过期未完成任务",
        "type": "bool",
        "default": true
      },
      "auto_cleanup_history": {
        "description": "每日自动清理已结束任务历史",
        "type": "bool",
        "default": true
      },
      "task_history_retention_days": {
        "description": "已结束任务自动保留天数",
        "type": "int",
        "slider": {"min": 1, "max": 365, "step": 1},
        "default": 30
      },
      "catalog_cache_ttl": {
        "description": "曲库缓存秒数",
        "type": "int",
        "slider": {"min": 60, "max": 86400, "step": 60},
        "default": 3600
      },
      "ongeki_source_url": {
        "description": "音击 arcade-songs 数据源",
        "type": "string",
        "default": "https://dp4p6x0xfi5o9.cloudfront.net/ongeki"
      },
      "maimai_song_url": {
        "description": "舞萌曲目接口",
        "type": "string",
        "default": "https://maimai.lxns.net/api/v0/maimai/song/list?version=25500&notes=false"
      },
      "chunithm_song_url": {
        "description": "中二曲目接口",
        "type": "string",
        "default": "https://maimai.lxns.net/api/v0/chunithm/song/list?version=23000&notes=false"
      },
      "maimai_asset_url": {
        "description": "舞萌素材地址",
        "type": "string",
        "default": "https://assets2.lxns.net/maimai"
      },
      "chunithm_asset_url": {
        "description": "中二素材地址",
        "type": "string",
        "default": "https://assets2.lxns.net/chunithm"
      }
    }
  }
}
