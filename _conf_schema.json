      },
      "gift_purchase_medium_price": {
        "type": "int",
        "default": 500,
        "description": "中礼物点数价格"
      },
      "gift_purchase_medium_weekly_cap": {
        "type": "int",
        "default": 3,
        "description": "中礼物每周购买上限"
      },
      "bloom_items": {
        "type": "list",
        "default": [
          "bloom_ticket",
          "flower_fragment"
        ],
        "description": "解花/超解花消耗的物品ID"
      },
      "bloom_levels": {
